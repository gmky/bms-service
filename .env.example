# BMS Service — Environment variables for deployment
# Copy this file to .env on the server and fill in the values,
# or set them as GitHub Secrets / Actions Variables.

# Docker image
IMAGE_OWNER=kalenz
IMAGE_TAG=latest

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
APP_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bms
APP_DATASOURCE_USERNAME=bms
APP_DATASOURCE_PASSWORD=changeme

# Redis
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=

# Keycloak (update issuer URI to match your Keycloak instance)
APP_SECURITY_KEYCLOAK_ISSUER_URI=http://localhost:8089/realms/kalenz
