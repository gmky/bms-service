<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20260908-create-business-function" author="HiepVH">
        <createTable tableName="BUSINESS_FUNCTION">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="FUNCTION_NAME" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="FUNCTION_CODE" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="DESCRIPTION" type="VARCHAR(500)"/>
        </createTable>

        <rollback>
            <dropTable tableName="BUSINESS_FUNCTION"/>
        </rollback>
    </changeSet>

    <changeSet id="20260908-insert-business-function-data" author="HiepVH">
        <sql>
            INSERT INTO BUSINESS_FUNCTION (ID, FUNCTION_NAME, FUNCTION_CODE, DESCRIPTION) VALUES
            (UUID(), 'Manage Privilege', 'manage.privilege', 'Manage Privilege business function for access control');
        </sql>

        <rollback>
            <delete tableName="BUSINESS_FUNCTION">
                <where>FUNCTION_CODE = 'manage.privilege'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
