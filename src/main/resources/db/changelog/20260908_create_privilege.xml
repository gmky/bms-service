<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20260908-create-privilege" author="HiepVH">
        <createTable tableName="PRIVILEGE">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="FUNCTION_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTION_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="PRIVILEGE"
                                baseColumnNames="FUNCTION_ID"
                                referencedTableName="BUSINESS_FUNCTION"
                                referencedColumnNames="ID"
                                constraintName="FK_PRIVILEGE_BUSINESS_FUNCTION"/>

        <addForeignKeyConstraint baseTableName="PRIVILEGE"
                                baseColumnNames="RESOURCE_ID"
                                referencedTableName="RESOURCE"
                                referencedColumnNames="ID"
                                constraintName="FK_PRIVILEGE_RESOURCE"/>

        <addForeignKeyConstraint baseTableName="PRIVILEGE"
                                baseColumnNames="ACTION_ID"
                                referencedTableName="ACTION"
                                referencedColumnNames="ID"
                                constraintName="FK_PRIVILEGE_ACTION"/>

        <rollback>
            <dropTable tableName="PRIVILEGE"/>
        </rollback>
    </changeSet>

    <changeSet id="20260908-insert-privilege-data" author="HiepVH">
        <sql>
            INSERT INTO PRIVILEGE (ID, FUNCTION_ID, RESOURCE_ID, ACTION_ID)
            SELECT
                UUID(),
                (SELECT ID FROM BUSINESS_FUNCTION WHERE FUNCTION_CODE = 'manage.privilege'),
                (SELECT ID FROM RESOURCE WHERE RESOURCE_CODE = 'entitlement'),
                ID
            FROM ACTION
            WHERE CODE IN ('view', 'create', 'update', 'delete', 'approve');
        </sql>

        <rollback>
            <delete tableName="PRIVILEGE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
