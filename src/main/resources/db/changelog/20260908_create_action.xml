<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20260908-create-action" author="HiepVH">
        <createTable tableName="ACTION">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="CODE" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="ACTION"/>
        </rollback>
    </changeSet>

    <changeSet id="20260908-insert-action-data" author="HiepVH">
        <sql>
            INSERT INTO ACTION (ID, CODE) VALUES
            (UUID(), 'view'),
            (UUID(), 'create'),
            (UUID(), 'update'),
            (UUID(), 'delete'),
            (UUID(), 'execute'),
            (UUID(), 'approve'),
            (UUID(), 'download');
        </sql>

        <rollback>
            <delete tableName="ACTION">
                <where>CODE IN ('view', 'create', 'update', 'delete', 'execute', 'approve', 'download')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
